// Change BUNDLE_ID_PREFIX or pass it to xcodebuild before signing for a device.
BUNDLE_ID_PREFIX = com.example.ThreePad
IPHONEOS_DEPLOYMENT_TARGET = 16.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 14
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
// Optional local signing overrides. This file is deliberately not supplied.
#include? "Local.xcconfig"
